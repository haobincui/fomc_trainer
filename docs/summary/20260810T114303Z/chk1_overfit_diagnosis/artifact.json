  "sources": [
    {
      "id": "trainer_state_source",
      "query": {
        "engine": "duckdb",
        "language": "sql",
        "sql": "WITH logs AS (SELECT log.* FROM read_json_auto('output/training/retrain_v2/chk1_clean_v2_override_full3ep_lr1e6_maxlen7168_20260810/adapters/chk1/checkpoint-210/trainer_state.json') AS state, UNNEST(state.log_history) AS rows(log)), train AS (SELECT step, loss FROM logs WHERE loss IS NOT NULL), eval AS (SELECT step, epoch, eval_loss, eval_mean_token_accuracy FROM logs WHERE eval_loss IS NOT NULL) SELECT e.step, e.epoch, AVG(t.loss) AS train_loss_rolling10, e.eval_loss, e.eval_mean_token_accuracy AS eval_accuracy FROM eval e JOIN train t ON t.step BETWEEN e.step - 9 AND e.step GROUP BY e.step, e.epoch, e.eval_loss, e.eval_mean_token_accuracy ORDER BY e.step",
        "description": "Reads durable train/eval log history and aligns each full eval with the trailing ten optimizer-step train losses.",
        "executed_at": "2026-08-10T11:43:03Z",
        "tables_used": [
          "output/training/retrain_v2/chk1_clean_v2_override_full3ep_lr1e6_maxlen7168_20260810/adapters/chk1/checkpoint-210/trainer_state.json"
        ],
        "filters": [
          "optimizer steps 1 through 210",
          "evaluation rows every 10 steps"
        ],
        "metric_definitions": [
          "Train loss is the arithmetic mean of the ten optimizer-step losses ending at each eval step.",
          "Eval loss is the complete 199-row validation loss recorded by Trainer."
        ]
      }
    },
    {
      "id": "loss_snapshot_source",
      "query": {
        "engine": "duckdb",
        "language": "sql",
        "sql": "SELECT step, epoch, train_loss_rolling10, train_loss_median10, eval_loss, gap_eval_minus_train_roll10, eval_accuracy FROM read_json_auto('docs/summary/20260810T114303Z/chk1_overfit_diagnosis/loss_snapshot.jsonl') ORDER BY step",
        "description": "Reads the reviewed loss-diagnosis snapshot derived from checkpoint-210 trainer state.",
        "executed_at": "2026-08-10T11:43:03Z",
        "tables_used": [
          "docs/summary/20260810T114303Z/chk1_overfit_diagnosis/loss_snapshot.jsonl"
        ],
        "filters": [
          "steps 10 through 210 at 10-step evaluation grain"
        ],
        "metric_definitions": [
          "gap_eval_minus_train_roll10 equals eval loss minus trailing-10 train loss mean."
        ]
      }
    },
    {
      "id": "probe_snapshot_source",
      "query": {
        "engine": "duckdb",
        "language": "sql",
        "sql": "SELECT checkpoint, status, mean_repetition, max_repetition, mean_delta_vs_chk0, max_case_delta_vs_chk0, eos_rate, contract_valid_rate, cap_rate, catastrophic_cases, periodic_tail_rate FROM read_json_auto('docs/summary/20260810T114303Z/chk1_overfit_diagnosis/probe_snapshot.jsonl') ORDER BY checkpoint",
        "description": "Reads reviewed strict-comparison summaries for checkpoints 80, 150, and 200.",
        "executed_at": "2026-08-10T11:43:03Z",
        "tables_used": [
          "docs/summary/20260810T114303Z/chk1_overfit_diagnosis/probe_snapshot.jsonl"
        ],
        "filters": [
          "fixed six sampled and two greedy cases per checkpoint",
          "3072-token cap",
          "comparison against frozen chk0 baseline"
        ],
        "metric_definitions": [
          "Mean repetition is the mean token 4-gram repetition rate across eight cases.",
          "Strict pass requires no cap, no periodic tail, no catastrophic case, zero contract-rate drop, mean delta at most 0.10, and per-case delta at most 0.20."
        ]
      }
    }
  ]
